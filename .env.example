# ===== Central（中央）=====
AF_HOST=0.0.0.0
AF_PORT=8000
AF_DB=data/fabric.db
# 节点准入：node_id:token，逗号分隔。生产必须换成长随机串（openssl rand -hex 24）
AF_NODE_TOKENS=test-node:dev-token,mapian:CHANGE_ME

# ===== Node（节点）=====
# AF_NODE_ID=mapian
# AF_NODE_TOKEN=CHANGE_ME
# AF_CENTRAL_URL=ws://154.64.231.1:8000
# 允许 echo 适配器执行 !shell 命令（默认拒绝，节点侧独立开关）
# AF_ALLOW_SHELL=1
# opencode 二进制路径（不在 PATH 时指定）
# AF_OPENCODE_BIN=/root/.npm/_npx/e2094862b59aac7b/node_modules/opencode-linux-x64/bin/opencode
# 节点工作目录（任务默认 cwd）
# AF_WORKSPACE=/opt/agent-fabric/workspace

# ===== Feishu Channel（默认关闭；启用前先停旧 dsh feishu 桥或换独立应用）=====
# AF_FEISHU_ENABLED=1
# AF_FEISHU_APP_ID=cli_xxx
# AF_FEISHU_APP_SECRET=xxx
# AF_FEISHU_ALLOWED_OPENIDS=ou_xxx,ou_yyy
